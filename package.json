{
  "name": "taskdrop",
  "version": "1.0.29",
  "description": "Desktop productivity sidebar app",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:all": "concurrently -k \"npm run dev:api\" \"npm run dev:portal\" \"vite\" \"wait-on http://localhost:5173 http://localhost:5000/health && electron .\"",
    "dev:api": "dotnet run --project api/TaskDrop.Api/TaskDrop.Api.csproj",
    "dev:portal": "npm run dev --prefix portal",
    "start": "electron .",
    "build:renderer": "vite build",
    "build:portal": "npm run build --prefix portal",
    "build:api": "dotnet publish api/TaskDrop.Api/TaskDrop.Api.csproj -c Release -o api/publish",
    "build": "vite build && npm run build:portal && electron-builder",
    "publish:installer": "npm run build && node scripts/copy-installer.js",
    "preview": "vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/signalr": "^8.0.17",
    "@sendgrid/mail": "^8.1.0",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "node-cron": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.enfinitecapital.taskdrop",
    "productName": "TaskDrop",
    "protocols": [
      {
        "name": "TaskDrop Auth",
        "schemes": [
          "taskdrop"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "services/**/*",
      "assets/**/*",
      "dist/**/*",
      "database/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "TaskDrop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://taskdrop.live/download/"
    }
  }
}
