# Twilio SMS (desktop reminders - optional)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
YOUR_PHONE_NUMBER=+1xxxxxxxxxx

# SendGrid Email (desktop reminders - optional)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=you@yourdomain.com
YOUR_EMAIL=you@yourdomain.com

# Cloud platform
TASKDROP_API_URL=http://localhost:5000/api
TASKDROP_PORTAL_URL=http://localhost:5174

# Production:
# TASKDROP_API_URL=https://taskdrop.live/api
# TASKDROP_PORTAL_URL=https://taskdrop.live
